generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PriceSnapshot {
  id        Int      @id @default(autoincrement())
  coinId    String
  price     Float
  createdAt DateTime @default(now())

  @@index([coinId, createdAt])
}

model TradeDecision {
  id            Int      @id @default(autoincrement())
  market        String
  coinId        String
  currentPrice  Float
  previousPrice Float?
  movingAverage Float?
  ema9          Float?
  ema21         Float?
  rsi           Float?
  macdValue     Float?
  macdSignal    Float?
  macdHistogram Float?
  bbUpper       Float?
  bbMiddle      Float?
  bbLower       Float?
  bbBandwidth   Float?
  trend         String
  decision      String
  confidence    Int
  riskScore     Int
  expectedValue Float
  reason        String
  aiReasoning   String
  createdAt     DateTime @default(now())

  @@index([coinId, createdAt])
}
