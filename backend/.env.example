# Образец настроек бэкенда. Скопируйте в .env: cp .env.example .env

# Ключ Groq: https://console.groq.com/keys
# Строка обязательна: без неё бэкенд не запустится.
# С пустым значением работают цены, графики и новости на языке оригинала;
# AI-комментарий, перевод новостей и текст свода не генерируются.
GROQ_API_KEY=

# Ключ Coinalyze для графика ликвидаций и открытых позиций за год и «Всё»:
# https://coinalyze.net/account/api-key/
# Бесплатный. Без него блок ликвидаций сообщает, что ключа нет, у открытых позиций — только 30 дней;
# остальное работает.
# COINALYZE_API_KEY=

# Необязательные настройки: ниже указаны значения по умолчанию.
# Чтобы изменить значение, уберите # и укажите своё. Пустым не оставляйте.

# Модель Groq
# GROQ_MODEL=openai/gpt-oss-120b

# Глубина размышлений модели: low, medium или high.
# off: не отправлять параметр (для моделей без размышлений)
# GROQ_REASONING_EFFORT=low

# Таймаут вызова Groq, мс. У перевода новостей свой таймаут, 60 с
# GROQ_TIMEOUT_MS=20000

# Число повторов при сбое вызова Groq
# GROQ_MAX_RETRIES=1
